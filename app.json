{
  "expo": {
    "name": "Rent Ledger",
    "slug": "rentledger",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-router",
        {
          "origin": "https://rentledger.expo.app"
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rent Ledger uses your photos to attach receipts to entries.",
          "cameraPermission": "Rent Ledger uses the camera to photograph receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dbjowett.rentledger"
    },
    "scheme": "rentledger"
  }
}
